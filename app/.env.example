# Copiá este archivo a app/.env.local para desarrollar. .env.local NO se versiona.

# De dónde salen los datos del local:
#   snapshot -> restaurantes reales capturados el 26/10/2026 (app/data/snapshots). Default, no necesita nada.
#   places   -> Google Places API (New) en vivo. Requiere GOOGLE_PLACES_API_KEY; si falta o falla, cae a snapshot y lo loguea.
#   mock     -> datos ficticios fijos (tests y fallback de último recurso).
DATA_SOURCE=snapshot

# Key de Google Places API (New). Vacía por defecto. Solo la lee el servidor (app/api/*), nunca el navegador.
# Costo estimado por diagnóstico: ~USD 0,057 (ver docs/research/costos.md).
GOOGLE_PLACES_API_KEY=

# URL pública del sitio. La usa el build para canonical, sitemap.xml y llms.txt del blog.
# Placeholder hasta que se confirme el dominio (se setea en Vercel).
SITE_URL=https://fudo-diagnostico.vercel.app
