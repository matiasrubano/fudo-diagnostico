{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/*.ts": {
      "includeFiles": "{data/snapshots/**,src/config/countries.json}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|blog/|assets/|sitemap\.xml|robots\.txt|llms\.txt|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
